{
  "meta": {
    "direction": "ledger",
    "source": "PROMPT.md section 7, Ledger to Live. Hex values are the implementation of that palette, not a sampled live site."
  },
  "color": {
    "light": {
      "paper": "#e3e6e0",
      "ink": "#1c1612",
      "muted": "#4a4038",
      "rule": "#8e1e24",
      "posted": "#0e5a3c",
      "line": "#6e6256",
      "sheet": "#fffdf8",
      "quiet": "#e7e0d4",
      "onInk": "#f4f0e6"
    },
    "dark": {
      "paper": "#161310",
      "ink": "#f3ecdf",
      "muted": "#d4c6b4",
      "rule": "#f0b4b4",
      "posted": "#9ed9b8",
      "line": "#a89880",
      "sheet": "#221e1a",
      "quiet": "#2c2722",
      "onInk": "#161310"
    }
  },
  "type": {
    "display": { "family": "Source Serif 4", "weight": 560, "opsz": 60 },
    "text": { "family": "Source Sans 3", "weight": 400 },
    "mono": { "family": "IBM Plex Mono", "weight": 500, "figures": "tabular-nums" },
    "scale": {
      "display": { "desktop": 56, "mobile": 34, "line": 1.05 },
      "title": { "desktop": 32, "mobile": 26, "line": 1.15 },
      "body": { "size": 18, "line": 1.5 },
      "small": { "size": 14, "line": 1.45 },
      "figure": { "size": 28, "line": 1.1 }
    }
  },
  "space": { "1": 8, "2": 16, "3": 28, "4": 48, "5": 80, "6": 128 },
  "radius": { "control": 0, "stamp": 2 },
  "shadow": { "sheet": "none" },
  "motion": {
    "durationMs": { "press": 120, "settle": 360 },
    "easing": { "out": "cubic-bezier(0.16, 1, 0.3, 1)" }
  },
  "contrastPairs": [
    { "theme": "light", "fg": "ink", "bg": "paper", "min": 4.5, "role": "body" },
    { "theme": "light", "fg": "muted", "bg": "paper", "min": 4.5, "role": "secondary text" },
    { "theme": "light", "fg": "rule", "bg": "paper", "min": 4.5, "role": "rule used as text" },
    { "theme": "light", "fg": "posted", "bg": "paper", "min": 4.5, "role": "posted text" },
    { "theme": "light", "fg": "ink", "bg": "sheet", "min": 4.5, "role": "text on sheet" },
    { "theme": "light", "fg": "muted", "bg": "sheet", "min": 4.5, "role": "secondary on sheet" },
    { "theme": "light", "fg": "ink", "bg": "quiet", "min": 4.5, "role": "quiet button" },
    { "theme": "light", "fg": "onInk", "bg": "ink", "min": 4.5, "role": "primary button" },
    { "theme": "light", "fg": "line", "bg": "paper", "min": 3, "role": "ui border" },
    { "theme": "light", "fg": "line", "bg": "sheet", "min": 3, "role": "ui border on sheet" },
    { "theme": "light", "fg": "muted", "bg": "quiet", "min": 4.5, "role": "disabled control" },
    { "theme": "dark", "fg": "ink", "bg": "paper", "min": 4.5, "role": "body" },
    { "theme": "dark", "fg": "muted", "bg": "paper", "min": 4.5, "role": "secondary text" },
    { "theme": "dark", "fg": "rule", "bg": "paper", "min": 4.5, "role": "rule used as text" },
    { "theme": "dark", "fg": "posted", "bg": "paper", "min": 4.5, "role": "posted text" },
    { "theme": "dark", "fg": "ink", "bg": "sheet", "min": 4.5, "role": "text on sheet" },
    { "theme": "dark", "fg": "muted", "bg": "sheet", "min": 4.5, "role": "secondary on sheet" },
    { "theme": "dark", "fg": "ink", "bg": "quiet", "min": 4.5, "role": "quiet button" },
    { "theme": "dark", "fg": "onInk", "bg": "ink", "min": 4.5, "role": "primary button" },
    { "theme": "dark", "fg": "line", "bg": "paper", "min": 3, "role": "ui border" },
    { "theme": "dark", "fg": "line", "bg": "sheet", "min": 3, "role": "ui border on sheet" },
    { "theme": "dark", "fg": "muted", "bg": "quiet", "min": 4.5, "role": "disabled control" }
  ]
}
